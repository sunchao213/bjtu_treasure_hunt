classDiagram
  class WorldScene {
    -SearchInteraction search
    -interact(held: boolean)
    +clearInteractions()
  }
  class SearchInteraction {
    -target: string
    -startedAtMs: number
    -opened: Set~string~
    +begin(id: string) boolean
    +progress() number
    +cancel() void
    +finish(item: ItemInstance, insert) ActionResult
  }
  class InventoryPort {
    <<interface>>
    +addLoot(item: ItemInstance) ActionResult
    +getCarriedItems() readonly ItemInstance[]
  }
  class EventBus {
    +emit(type, payload) void
  }
  class ItemInstance {
    +instanceId: string
    +itemId: string
    +origin: ItemOrigin
  }
  WorldScene *-- SearchInteraction
  WorldScene --> InventoryPort : inserts loot
  WorldScene --> EventBus : LocationInteracted
  SearchInteraction ..> ItemInstance : completes with
